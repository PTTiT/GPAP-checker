<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.geocomply.test.gpapchecker.view.InsetsAwareLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_apps_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_apps_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_description_extended"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_compare_packages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_compare_packages"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:background="#E3F2FD"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_packages_api_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/packages_api_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_packages_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="#FFEBEE"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_applications_api_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/applications_api_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_applications_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="#E8F5E8"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="#F44336"
                    android:textSize="14sp"
                    android:background="#FFEBEE"
                    android:padding="8dp" />

            </LinearLayout>
        </ScrollView>

    </com.geocomply.test.gpapchecker.view.InsetsAwareLinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>